# ──────────────────────────────────────
# Voltage — Local Development Environment
# Copy to .env and fill in values
# ──────────────────────────────────────

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── PostgreSQL ──
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/voltage?schema=public

# ── S3 / MinIO (local) ──
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=voltage-deployments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ── GitHub OAuth (create at https://github.com/settings/developers) ──
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ── GitHub Webhook ──
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# ── Auth ──
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_random_64_char_hex_string
NEXTAUTH_SECRET=change_me_to_a_random_64_char_hex_string
NEXTAUTH_URL=http://localhost:3000

# ── Control Plane ──
CONTROL_PLANE_PORT=3001
CONTROL_PLANE_URL=http://localhost:3001

# ── Reverse Proxy ──
PROXY_PORT=8080
BASE_DOMAIN=voltage.localhost

# ── Builder ──
BUILD_TIMEOUT_MS=600000
BUILD_MEMORY_MB=512
BUILD_CPU_CORES=1
MAX_CONCURRENT_BUILDS=3
BUILDER_IMAGE=voltage-builder:latest
